@model KUETHardwareAccelerationClub.Models.ProjectsPageViewModel
@{
    ViewBag.Title = "Projects";
}

@if (TempData["ProjectMessage"] != null)
{
    <div class="alert">@TempData["ProjectMessage"]</div>
}

<section class="card">
    <h1>Member Projects Showcase</h1>
    <p>Explore innovative hardware acceleration projects and collaborate through comments.</p>
</section>

@foreach (var project in Model.Projects)
{
    <section class="card project-card">
        <h2>@project.Title</h2>
        <p>@project.Summary</p>
        <p><strong>Lead:</strong> @project.Lead</p>
        <p><strong>Tech Stack:</strong> @project.Stack</p>

        <div class="comments">
            <h3>Comments</h3>
            @if (!project.Comments.Any())
            {
                <p>No comments yet.</p>
            }
            else
            {
                foreach (var comment in project.Comments.OrderByDescending(c => c.CreatedAtUtc))
                {
                    <article class="comment-item">
                        <p>@comment.Content</p>
                        <small>
                            By @comment.AuthorEmail · @comment.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy hh:mm tt")
                            · Status: @comment.ModerationStatus
                            · Reports: @comment.ReportCount
                        </small>

                        @if (!string.IsNullOrWhiteSpace(Model.CurrentUserEmail))
                        {
                            using (Html.BeginForm("ReportComment", "Projects", FormMethod.Post, new { @class = "report-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="commentId" value="@comment.Id" />
                                <select name="reason" required>
                                    <option value="Spam">Spam</option>
                                    <option value="Harassment">Harassment</option>
                                    <option value="OffTopic">Off Topic</option>
                                    <option value="Other">Other</option>
                                </select>
                                <button type="submit" class="btn-secondary">Report</button>
                            }
                        }
                    </article>
                }
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.CurrentUserEmail))
        {
            using (Html.BeginForm("AddComment", "Projects", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="projectId" value="@project.Id" />
                <label>Add Comment</label>
                <textarea name="content" rows="3" required></textarea>
                <button type="submit" class="btn-primary">Post Comment</button>
            }
        }
        else
        {
            <p><a href="@Url.Action("Auth", "Account")">Login as member</a> to comment and report.</p>
        }
    </section>
}
