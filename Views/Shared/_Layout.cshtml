@{
    var currentUser = User.Identity?.IsAuthenticated == true ? User.Identity?.Name : null;
    var isAdmin = User.IsInRole("Admin");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hardware Acceleration Club of KUET</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a asp-controller="Home" asp-action="Index" class="brand">
            <img src="~/images/club-logo.svg" alt="Hack Logo" class="brand-logo" />
            <span>HACK</span>
        </a>
        <nav class="top-menu" id="topMenu">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Projects" asp-action="Index">Projects</a>
            <a asp-controller="Events" asp-action="Index">Events</a>
            <a asp-controller="Team" asp-action="MeetTheTeam">Team</a>
            <a asp-controller="Contact" asp-action="Index">Contact</a>
            @if (isAdmin)
            {
                <a asp-controller="Admin" asp-action="Index">Admin</a>
            }
            @if (User?.Identity?.IsAuthenticated == true)
            {
                <details class="account-menu">
                    <summary class="account-menu-trigger">Account</summary>
                    <div class="account-menu-panel">
                        @if (!string.IsNullOrWhiteSpace(currentUser))
                        {
                            <span class="account-menu-user">@currentUser</span>
                        }
                        <a asp-controller="Account" asp-action="Logout" class="account-menu-link">Sign Out</a>
                    </div>
                </details>
            }
            else
            {
                <a asp-controller="Account" asp-action="Auth">Sign In</a>
            }
        </nav>
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">☰</button>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        © @DateTime.UtcNow.Year Hardware Acceleration Club of KUET · All Rights Reserved
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>