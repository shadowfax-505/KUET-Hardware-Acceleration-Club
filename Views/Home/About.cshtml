@{
    ViewData["Title"] = "About";
}

<section class="card glass">
    <h1>About the Club</h1>
    <p>The Hardware Acceleration Club of KUET is a student-led community focused on high-performance systems and real-world accelerator design.</p>
</section>

<section class="two-column">
    <article class="card glass">
        <h2>What We Do</h2>
        <ul class="bullet-list">
            <li>Project-based learning on FPGA and embedded AI.</li>
            <li>Hands-on workshops and technical mentorship.</li>
            <li>Research and competition preparation support.</li>
        </ul>
    </article>
    <article class="card glass">
        <h2>Who Can Join</h2>
        <ul class="bullet-list">
            <li>Any KUET student with interest in hardware/software co-design.</li>
            <li>Beginners and advanced members are both welcome.</li>
        </ul>
    </article>
</section>